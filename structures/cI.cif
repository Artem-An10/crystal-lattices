<span class="ͼb">const</span> <span class="ͼg">text</span> = <span class="ͼb">await</span> response.text();</div><div class="cm-line"><br></div><div class="cm-line">        <span class="ͼm">// Частая ошибка: сервер вместо отсутствующего файла</span></div><div class="cm-line">        <span class="ͼm">// возвращает HTML-страницу.</span></div><div class="cm-line">        <span class="ͼb">if</span> (<span class="ͼf">/^\s*(&lt;!doctype html|&lt;html)/i</span>.test(text)) {</div><div class="cm-line">          <span class="ͼb">throw</span> <span class="ͼb">new</span> <span class="ͼj">Error</span>(<span class="ͼe">"Сервер вернул HTML вместо CIF"</span>);</div><div class="cm-line">        }</div><div class="cm-line"><br></div><div class="cm-line">        currentCif = text;</div><div class="cm-line">        currentFileName = path;</div><div class="cm-line"><br></div><div class="cm-line">        showStructure(<span class="ͼe">"1 1 1"</span>);</div><div class="cm-line">      } <span class="ͼb">catch</span> (<span class="ͼg">error</span>) {</div><div class="cm-line">        status.textContent =</div><div class="cm-line">          <span class="ͼe">"Автоматически открыть "</span> + path + <span class="ͼe">" не удалось.</span><span class="ͼf">\n</span><span class="ͼe">"</span> +</div><div class="cm-line">          <span class="ͼe">"Выбери CIF-файл вручную кнопкой выше."</span>;</div><div class="cm-line">      }</div><div class="cm-line">    }</div><div class="cm-line"><br></div><div class="cm-line">    <span class="ͼb">if</span> (!window.Jmol) {</div><div class="cm-line">      status.textContent =</div><div class="cm-line">        <span class="ͼe">"Не удалось загрузить JSmol. "</span> +</div><div class="cm-line">        <span class="ͼe">"Проверь интернет-соединение и обнови страницу."</span>;</div><div class="cm-line">    } <span class="ͼb">else</span> {</div><div class="cm-line">      <span class="ͼb">const</span> <span class="ͼg">info</span> = {</div><div class="cm-line">        <span class="ͼl">width</span>: <span class="ͼe">"100%"</span>,</div><div class="cm-line">        <span class="ͼl">height</span>: <span class="ͼe">"100%"</span>,</div><div class="cm-line">        <span class="ͼl">use</span>: <span class="ͼe">"HTML5"</span>,</div><div class="cm-line"><br></div><div class="cm-line">        <span class="ͼl">j2sPath</span>:</div><div class="cm-line">          <span class="ͼe">"https://chemapps.stolaf.edu/jmol/jsmol/j2s"</span>,</div><div class="cm-line"><br></div><div class="cm-line">        <span class="ͼl">color</span>: <span class="ͼe">"#172033"</span>,</div><div class="cm-line"><br></div><div class="cm-line">        <span class="ͼl">script</span>: <span class="ͼe">'background "[23,32,51]";'</span>,</div><div class="cm-line"><br></div><div class="cm-line">        <span class="ͼl">readyFunction</span>: <span class="ͼb">function</span> (<span class="ͼg">readyApplet</span>) {</div><div class="cm-line">          applet = readyApplet;</div><div class="cm-line">          viewerReady = <span class="ͼc">true</span>;</div><div class="cm-line"><br></div><div class="cm-line">          <span class="ͼb">if</span> (currentCif) {</div><div class="cm-line">            showStructure(<span class="ͼe">"1 1 1"</span>);</div><div class="cm-line">          } <span class="ͼb">else</span> {</div><div class="cm-line">            tryAutomaticLoad();</div><div class="cm-line">          }</div><div class="cm-line">        }</div><div class="cm-line">      };</div><div class="cm-line"><br></div><div class="cm-line">      <span class="ͼm">// Размещаем JSmol внутри блока viewer.</span></div><div class="cm-line">      Jmol.setDocument(<span class="ͼd">0</span>);</div><div class="cm-line"><br></div><div class="cm-line">      document.getElementById(<span class="ͼe">"viewer"</span>).innerHTML =</div><div class="cm-line">        Jmol.getAppletHtml(<span class="ͼe">"crystalViewer"</span>, info);</div><div class="cm-line">    }</div><div class="cm-line">  &lt;/<span class="ͼi">script</span>&gt;</div><div class="cm-line">&lt;/<span class="ͼi">body</span>&gt;</div><div class="cm-line">&lt;/<span class="ͼi">html</span>&gt;</div></div><div class="cm-layer cm-layer-above cm-cursorLayer" aria-hidden="true" style="z-index: 150; animation-duration: 1200ms; animation-name: cm-blink;"><div class="cm-cursor cm-cursor-primary" style="left: 362.458px; top: 5256.46px; height: 16px;"></div></div><div class="cm-layer cm-selectionLayer" aria-hidden="true" style="z-index: -2;"></div></div></div></div><!----></div> <div class="bg-gray-50 dark:bg-black dark:text-white max-w-full overflow-x-auto scrollbar-hidden" id="plt-canvas-c72b41ae-d3b1-4d7f-91a2-782cfe329dce-de4ae5c5-ca15-4a21-b823-dbbdaf9926ce-msg_0162d96768b3baf1006ad6716016f887d1acee351e82548edf-20"></div> <!----><!----><!----></div></div><!----><!----><!----><h2 dir="auto"><!----><!----><!---->3. Откуда взять структуры</h2><!----><!----><p dir="auto"><!----><!----><!---->CIF-файлы можно скачать, например, из <!----><strong><!----><!----><!----><a target="_blank" rel="nofollow" href="https://www.crystallography.net/cod/"><!----><!----><!---->Crystallography Open Database<!----></a><!----></strong><!----><!---->. Важно проверять <!----><strong><!----><!----><!---->вещество, модификацию и пространственную группу<!----></strong><!----><!----> — одинаковая формула не всегда означает одинаковую структуру.<!----></p><!----><!----><!----><p dir="auto"><!----><!----><!---->На первом этапе можно просто:<!----></p><!----><!----><ol dir="auto" start="1"><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Нажать на вещество в нашей программе.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Нажать <!----><strong><!----><!----><!---->«Открыть CIF-файл»<!----></strong><!----><!---->.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Выбрать скачанный файл этого вещества.<!----></li></ol><!----><!----><!----><p dir="auto"><!----><!----><strong><!----><!----><!---->Это уже будет настоящая атомная модель из файла<!----></strong><!----><!---->, а не условная решетка Браве.<!----></p><!----><!----><!----><h3 dir="auto"><!----><!----><!---->Чтобы ячейка открывалась сразу по ссылке</h3><!----><!----><p dir="auto"><!----><!----><!---->Создай рядом папку <!----><code class="codespan cursor-pointer ">structures</code><!----><!----> и положи туда CIF-файлы под такими именами:<!----></p><!----><!----><div class="relative w-full group mb-2"><div class="scrollbar-hidden relative overflow-x-auto max-w-full"><table class=" w-full text-sm text-start text-gray-500 dark:text-gray-400 max-w-full rounded-xl" dir="auto"><thead class="text-xs text-gray-700 uppercase dark:text-gray-400 border-none"><tr><th scope="col" class="px-2.5! py-2! cursor-pointer border-b border-gray-100! dark:border-gray-800!" style=""><div class="gap-1.5 text-start"><div class="shrink-0 break-normal"><!----><!----><!---->Файл<!----></div></div></th><th scope="col" class="px-2.5! py-2! cursor-pointer border-b border-gray-100! dark:border-gray-800!" style=""><div class="gap-1.5 text-start"><div class="shrink-0 break-normal"><!----><!----><!---->Структура<!----></div></div></th></tr></thead><tbody><tr class="text-xs"><td class="px-3! py-2! text-gray-900 dark:text-white w-max border-b border-gray-50! dark:border-gray-850!" style=""><div class="break-normal"><!----><!----><code class="codespan cursor-pointer ">aP.cif</code><!----></div></td><td class="px-3! py-2! text-gray-900 dark:text-white w-max border-b border-gray-50! dark:border-gray-850!" style=""><div class="break-normal"><!----><!----><!---->Медный купорос<!----></div></td></tr><tr class="text-xs"><td class="px-3! py-2! text-gray-900 dark:text-white w-max border-b border-gray-50! dark:border-gray-850!" style=""><div class="break-normal"><!----><!----><code class="codespan cursor-pointer ">mP.cif</code><!----></div></td><td class="px-3! py-2! text-gray-900 dark:text-white w-