d"></path></svg><!----></button></div><!----> <!----><!----></div></div><!----><!----><p dir="auto"><!----><!----><strong><!----><!----><!---->Это страницы поиска, не прямые ссылки на файлы.<!----></strong><!----><!----> В результатах нужно нажать <!----><strong><!----><!----><!---->CIF<!----></strong><!----><!----> у подходящей записи. Чтобы не скачать другую модификацию, ориентируйся на пространственную группу:<!----></p><!----><!----><!----><ul dir="auto"><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->сера: <!----><strong><!----><!----><!---->Fddd<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->рутил: <!----><strong><!----><!----><!---->P4₂/mnm<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->бета-олово: <!----><strong><!----><!----><!---->I4₁/amd<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->магний: <!----><strong><!----><!----><!---->P6₃/mmc<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->кальцит: <!----><strong><!----><!----><!---->R−3c<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->CsCl: <!----><strong><!----><!----><!---->Pm−3m<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->альфа-железо: <!----><strong><!----><!----><!---->Im−3m<!----></strong><!----><!---->;<!----></li><li class="text-start "><!----><!----><!----><!----><!----><!----><!---->медь: <!----><strong><!----><!----><!---->Fm−3m<!----></strong><!----><!---->.<!----></li></ul><!----><!----><!----><h3 dir="auto"><!----><!----><!---->Но проще сохранить файлы по прежним ссылкам</h3><!----><!----><p dir="auto"><!----><!----><!---->Если прежняя ссылка открывает текст примерно такого вида:<!----></p><!----><!----><!----><div><div dir="ltr" class="relative  flex flex-col rounded-2xl border border-gray-100/30 dark:border-gray-850/30 my-0.5"><div class="sticky top-10 left-0 right-0 py-1.5 px-3.5 gap-2 flex items-center justify-end w-full z-10 text-xs text-black dark:text-white bg-white dark:bg-black rounded-t-2xl"><div class="flex-1 truncate"><!----><div class="flex"><!----><span class=" truncate text-ellipsis">text</span></div><!----> <!----><!----></div> <div class="flex items-center gap-0.5 shrink-0"><button class="flex gap-1 items-center bg-none border-none transition rounded-md px-1.5 py-0.5 bg-white dark:bg-black"><div class=" -translate-y-[0.5px]"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="size-3"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15 12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9"></path></svg><!----></div> <div>Свернуть</div></button> <!----> <button class="save-code-button bg-none border-none transition rounded-md px-1.5 py-0.5 bg-white dark:bg-black">Сохранить</button><!----> <button class="copy-code-button bg-none border-none transition rounded-md px-1.5 py-0.5 bg-white dark:bg-black">Копировать</button> <!----></div></div> <div class="language-text rounded-t-2xl -mt-8 rounded-b-2xl overflow-hidden"><div class=" pt-6.5 bg-white dark:bg-black"></div> <!----><div id="code-textarea-c72b41ae-d3b1-4d7f-91a2-782cfe329dce-08332047-fcf4-437d-bb58-f8f1cb995074-msg_04b1afbdcfa23da4006ad67a9504e487d18b256b5f96f350f1-12" class="text-sm h-full w-full min-w-0 overflow-hidden"><div class="cm-editor ͼ1 ͼ2 ͼ4"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller"><div class="cm-gutters cm-gutters-before" aria-hidden="true" style="min-height: 105.969px; position: sticky;"><div class="cm-gutter cm-lineNumbers"><div class="cm-gutterElement" style="height: 0px; visibility: hidden; pointer-events: none;">9</div><div class="cm-gutterElement cm-activeLineGutter" style="height: 19.5938px; margin-top: 4px;">1</div><div class="cm-gutterElement" style="height: 19.5938px;">2</div><div class="cm-gutterElement" style="height: 19.5938px;">3</div><div class="cm-gutterElement" style="height: 19.5938px;">4</div><div class="cm-gutterElement" style="height: 19.5938px;">5</div></div><div class="cm-gutter cm-foldGutter"><div class="cm-gutterElement" style="height: 0px; visibility: hidden; pointer-events: none;"><span title="Unfold line">›</span></div><div class="cm-gutterElement cm-activeLineGutter" style="height: 19.5938px; margin-top: 4px;"></div></div></div><div spellcheck="false" autocorrect="off" autocapitalize="off" writingsuggestions="false" translate="no" contenteditable="true" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-placeholder="Введите здесь свой код..."><div class="cm-line cm-activeLine">data_...</div><div class="cm-line">_cell_length_a ...</div><div class="cm-line">_cell_length_b ...</div><div class="cm-line">...</div><div class="cm-line">_atom_site_fract_x</div></div><div class="cm-layer cm-layer-above cm-cursorLayer" aria-hidden="true" style="z-index: 150; animation-duration: 1200ms;"><div class="cm-cursor cm-cursor-primary" style="left: 35.6979px; top: 5.33333px; height: 16px;"></div></div><div class="cm-layer cm-selectionLayer" aria-hidden="true" style="z-index: -2;"></div></div></div></div><!----></div> <div class="bg-gray-50 dark:bg-black dark:text-white max-w-full overflow-x-auto scrollbar-hidden" id="plt-canvas-c72b41ae-d3b1-4d7f-91a2-782cfe329dce-08332047-fcf4-437d-bb58-f8f1cb995074-msg_04b1afbdcfa23da4006ad67a9504e487d18b256b5f96f350f1-12"></div> <!----><!----><!----></div></div><!----><!----><!----><p dir="auto"><!----><!----><!---->— <!----><strong><!----><!----><!---->это и есть нужный CIF-файл<!----></strong><!----><!---->, а не ошибка.<!----></p><!----><!----><!----><p dir="auto"><!----><!----><!---->Сделай так:<!----></p><!----><!----><!----><ol dir="auto" start="1"><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Открой ссылку.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Нажми <!----><strong><!----><!----><!---->Ctrl + S<!----></strong><!----><!---->.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Укажи имя из таблицы, например <!----><strong><!----><!----><code class="codespan cursor-pointer ">oF.cif</code><!----></strong><!----><!---->.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Если есть выбор типа файла, выбери <!----><strong><!----><!----><!---->«Все файлы»<!----></strong><!----><!---->.<!----></li><li class="text-start"><!----> <!----><!----><!----><!----><!----><!---->Проверь, что файл не называется <!----><code class="codespan cursor-pointer ">oF.cif.txt</code><!----><!---->.<!----></li></ol><!----><!----><!----><p dir="auto"><!----><!----><!---->Затем выбери его в нашей программе через <!----><strong><!----><!----><!---->«Открыть CIF-файл»<!----></strong><!----><!---->.<!----></p><!----><!----><!----><p dir="auto"><!----><!----><!---->Если же вместо текста появляется <!----><strong><!----><!----><!---->ошибка или страница не открывается<!----></strong><!----><!---->, напиши, что именно отображается — тогда проблема не в скачивании, а в доступе к GitHub.<!----></p><!----></div><!----></div> <div class="absolute rounded-lg mt-1 text-xs z-9999" style="display: none" id="floating-buttons-c72b41ae-d3b1-4d7f-91a2-782cfe329dce-08332047-fcf4-437d-bb58-f8f1cb995074"><div class="flex flex-row shrink-0 p-0.5 bg-white dark:bg-gray-850 dark:text-gray-100 text-medium rounded-xl shadow-xl border border-gray-100 dark:border-gray-800"><button class="px-1.5 py-[0.0625rem] hover:bg-gray-50 dark:hover:bg-gray-800 rounded-xl flex items-center gap-1 min-w-fit transition" aria-label="Спросить"><!----><svg aria-hidden="true" xmlns="http://www.w3.org/