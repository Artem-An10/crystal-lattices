: 986px;" class="cm-content" role="textbox" aria-multiline="true" aria-placeholder="Введите здесь свой код..." data-language="javascript" aria-autocomplete="list"><div class="cm-line">&lt;a</div><div class="cm-line">  href=<span class="ͼe">"substance.html?id=${latticeId}&amp;name=${encodeURIComponent(example.name)}&amp;formula=${encodeURIComponent(example.formula)}"</span></div><div class="cm-line">  style=<span class="ͼe">"color: #65bdff; text-decoration: underline;"</span></div><div class="cm-line cm-activeLine">&gt;</div><div class="cm-line">  ${example.name}</div><div class="cm-line">&lt;<span class="ͼf">/a&gt;&lt;br&gt;</span></div></div><div class="cm-layer cm-layer-above cm-cursorLayer" aria-hidden="true" style="z-index: 150; animation-duration: 1200ms; animation-name: cm-blink;"><div class="cm-cursor cm-cursor-primary" style="left: 43.3958px; top: 64.1146px; height: 16px;"></div></div><div class="cm-layer cm-selectionLayer" aria-hidden="true" style="z-index: -2;"></div></div></div></div><!----></div> <div class="bg-gray-50 dark:bg-black dark:text-white max-w-full overflow-x-auto scrollbar-hidden" id="plt-canvas-c72b41ae-d3b1-4d7f-91a2-782cfe329dce-de4ae5c5-ca15-4a21-b823-dbbdaf9926ce-msg_0162d96768b3baf1006ad6716016f887d1acee351e82548edf-13"></div> <!----><!----><!----></div></div><!----><!----><!----><p dir="auto"><!----><!----><!---->Теперь названия веществ будут открывать страницу <!----><code class="codespan cursor-pointer ">substance.html</code><!----><!---->.<!----></p><!----><!----><!----><h2 dir="auto"><!----><!----><!---->2. Создай файл <!----><code class="codespan cursor-pointer ">substance.html</code></h2><!----><!----><p dir="auto"><!----><!----><!---->Сохрани этот файл <!----><strong><!----><!----><!---->в той же папке, что и <!----><code class="codespan cursor-pointer ">bravais.js</code><!----><!----> и страницы решеток<!----></strong><!----><!---->:<!----></p><!----><!----><!----><div><div dir="ltr" class="relative  flex flex-col rounded-2xl b